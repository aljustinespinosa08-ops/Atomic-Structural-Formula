body{
    font-family:Arial;
    background:#0f172a;
    color:white;
    text-align:center;
}

.container{
    width:400px;
    margin:auto;
    margin-top:80px;
    padding:20px;
    background:#1e293b;
    border-radius:15px;
}

button{
    margin:10px;
    padding:12px 20px;
    border:none;
    border-radius:8px;
    cursor:pointer;
    background:#3b82f6;
    color:white;
    font-size:16px;
}

button:hover{
    background:#2563eb;
}

#result{
    margin-top:20px;
    font-size:20px;
}